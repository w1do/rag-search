FROM python:3.12.11-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /bin/uv
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-hashes --no-emit-project --output-file requirements.txt \
    && uv pip install --system --no-cache --requirements requirements.txt \
    && rm requirements.txt
COPY alembic.ini ./alembic.ini
COPY apps/api/app ./app
COPY apps/worker/worker ./worker
COPY packages/core/vector_core ./vector_core
